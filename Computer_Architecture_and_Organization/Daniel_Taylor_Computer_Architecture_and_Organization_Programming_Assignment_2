addi $s0, $zero, 5
addi $s1, $zero, 9
addi $s2, $zero, 8 

#program logic
#check if s0 is less than s1
slt $t0, $s0, $s1

#check if t0 is 0 (meaning s0 is NOT less than s1, and is infact the greater of the 2)
beq $t0, $zero,  s0GR
#if no jump, then store s1 in s3 temporarily since we know know it's at least greater than or equal to s0

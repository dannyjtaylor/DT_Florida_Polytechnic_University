#For the following C statement, write the corresponding MIPS assembly code. Assume that the variables f, g, h, i, and j are assigned to registers $s0, $s1, $s2, $s3, and $s4, 
#respectively. Assume that the base address of the arrays A and B are in registers $s6 and $s7, respectively.

#B[10] = A[i + j];

# A[i+j]
add $t0, $s3, $s4 # t0 = i + j
sll $t0, $t0, 2 # have index (i+j) multiplied by 4 for offset
add $t1, $s6, $t0 # base address + offset
lw $t2, 0($t1) # make A[i+j] 

#B[10]
addi $t3, $zero, 10  # t3 = 10
sll $t3, $t3, 2 # times 4 for offset
add $t4, $s7, $t3 # base address + offset

lw $t2, 0($t4) # store B[10] into A[i+j]


